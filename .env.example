# Copy to .env for local use. Real values belong ONLY in Vercel (Settings > Environment Variables) - never commit them.
# Local `npm run dev` needs none of these: it uses an in-memory database that resets on restart.

# Neon connection string, exactly as Neon shows it (it ends with ?sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Random string, 32+ characters. Use a different one for Production and Staging.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Production only: the site's own address, no trailing slash.
BETTER_AUTH_URL=https://your-app.vercel.app

# Optional: extra allowed origins (custom domain), comma-separated.
# TRUSTED_ORIGINS=https://app.example.com

# Phone push notifications (optional). Generate with: npx web-push generate-vapid-keys
# Use a DIFFERENT pair for Production and for Staging (Preview). See docs/PUSH-SETUP.md.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Scheduled push reminders (Production only). A long random string, 32+ characters; the same value goes in GitHub
# (repository secret CRON_SECRET). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# Staging (Vercel Preview) only. Never set this in Production.
# AUTH_RATE_LIMIT=off
