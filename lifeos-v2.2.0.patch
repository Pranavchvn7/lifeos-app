+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { createBlank, type LifeData } from "./model";
+import {
+  dayRecord,
+  dayStates,
+  findHabit,
+  habitStats,
+  lastDays,
+  monthBars,
+  monthGrid,
+  shiftMonth,
+  streakFrom,
+  streakSeries,
+  weeklyBuckets,
+  type HabitRef,
+} from "./habit-view";
+
+// 2026-11-23 is a Monday.
+const TODAY = "2026-11-23";
+
+function base(overrides: Partial<LifeData> = {}): LifeData {
+  return {
+    ...createBlank("2026-11-01"),
+    dos: [{ id: "read", label: "Read", since: "2026-11-01" }],
+    donts: [{ id: "sugar", label: "No sugar", since: "2026-11-01" }],
+    ...overrides,
+  };
+}
+
+const read: HabitRef = { kind: "do", habit: { id: "read", label: "Read", since: "2026-11-01" } };
+
+describe("finding a habit", () => {
+  it("finds do's and don'ts by id, and nothing for an unknown id", () => {
+    const data = base();
+    assert.equal(findHabit(data, "read")?.kind, "do");
+    assert.equal(findHabit(data, "sugar")?.kind, "dont");
+    assert.equal(findHabit(data, "nope"), null);
+  });
+});
+
+describe("day states", () => {
+  it("a logged tick is done; an unlogged past day is missed; today unlogged is open", () => {
+    const data = base({ doChecks: { "2026-11-20": { read: { done: true, notes: "" } } } });
+    assert.equal(dayRecord(data, read, "2026-11-20", TODAY).state, "done");
+    assert.equal(dayRecord(data, read, "2026-11-19", TODAY).state, "missed");
+    assert.equal(dayRecord(data, read, TODAY, TODAY).state, "open");
+  });
+
+  it("days before the start date, after today, frozen and off-schedule are not counted", () => {
+    const habit = { id: "read", label: "Read", since: "2026-11-10", days: [1, 2, 3, 4, 5] };
+    const ref: HabitRef = { kind: "do", habit };
+    const data = base({ dos: [habit], freezeDays: { "2026-11-12": true } });
+    assert.equal(dayRecord(data, ref, "2026-11-09", TODAY).state, "before");
+    assert.equal(dayRecord(data, ref, "2026-11-12", TODAY).state, "frozen"); // Thursday, frozen
+    assert.equal(dayRecord(data, ref, "2026-11-14", TODAY).state, "off"); // Saturday
+    assert.equal(dayRecord(data, ref, "2026-11-24", TODAY).state, "future");
+  });
+
+  it("an amount habit counts as done at the daily target, and keeps the logged value", () => {
+    const habit = { id: "pages", label: "Read", since: "2026-11-01", amount: { unit: "pages", target: 25 } };
+    const ref: HabitRef = { kind: "do", habit };
+    const data = base({
+      dos: [habit],
+      doChecks: {
+        "2026-11-20": { pages: { done: true, notes: "", value: 30 } },
+        "2026-11-21": { pages: { done: false, notes: "", value: 10 } },
+      },
+    });
+    assert.equal(dayRecord(data, ref, "2026-11-20", TODAY).state, "done");
+    assert.equal(dayRecord(data, ref, "2026-11-20", TODAY).value, 30);
+    assert.equal(dayRecord(data, ref, "2026-11-21", TODAY).state, "missed");
+    assert.equal(dayRecord(data, ref, "2026-11-21", TODAY).value, 10);
+  });
+
+  it("a don't is done when avoided and missed when given in", () => {
+    const ref: HabitRef = { kind: "dont", habit: { id: "sugar", label: "No sugar", since: "2026-11-01" } };
+    const data = base({
+      dontChecks: {
+        "2026-11-20": { sugar: { status: "Avoided", notes: "" } },
+        "2026-11-21": { sugar: { status: "Gave In", notes: "cake" } },
+      },
+    });
+    assert.equal(dayRecord(data, ref, "2026-11-20", TODAY).state, "done");
+    assert.equal(dayRecord(data, ref, "2026-11-21", TODAY).state, "missed");
+    assert.equal(dayRecord(data, ref, "2026-11-21", TODAY).notes, "cake");
+  });
+});
+
+describe("streaks and stats", () => {
+  it("a missed day breaks the run; open, off and frozen days do not", () => {
+    const data = base({
+      doChecks: {
+        "2026-11-17": { read: { done: true, notes: "" } },
+        "2026-11-18": { read: { done: true, notes: "" } },
+        "2026-11-19": { read: { done: true, notes: "" } },
+        "2026-11-21": { read: { done: true, notes: "" } },
+        "2026-11-22": { read: { done: true, notes: "" } },
+      },
+      freezeDays: { "2026-11-20": true },
+    });
+    const { current, best } = streakFrom(dayStates(data, read, TODAY, "2026-11-15"));
+    assert.equal(best, 5); // 17,18,19 + frozen 20 + 21,22
+    assert.equal(current, 5); // today is open (neutral), so the run through 22 is still live
+  });
+
+  it("stats: completion over countable days, and amount totals and averages", () => {
+    const habit = { id: "pages", label: "Read", since: "2026-11-20", amount: { unit: "pages" } };
+    const ref: HabitRef = { kind: "do", habit };
+    const data = base({
+      dos: [habit],
+      doChecks: {
+        "2026-11-20": { pages: { done: true, notes: "", value: 20 } },
+        "2026-11-21": { pages: { done: true, notes: "", value: 10 } },
+      },
+    });
+    const stats = habitStats(data, ref, TODAY);
+    assert.equal(stats.total, 30); // sum of pages
+    assert.equal(stats.countable, 3); // 20, 21 done and 22 missed; today (23) open
+    assert.equal(stats.average, 10); // 30 pages over 3 countable days
+    assert.equal(stats.best, 2);
+  });
+
+  it("tick stats: kept days and completion share", () => {
+    const data = base({
+      doChecks: {
+        "2026-11-17": { read: { done: true, notes: "" } },
+        "2026-11-18": { read: { done: true, notes: "" } },
+      },
+    });
+    const stats = habitStats(data, read, TODAY);
+    assert.equal(stats.total, 2);
+    assert.equal(stats.countable, 22); // 1 Nov to 22 Nov (today open)
+    assert.ok(Math.abs(stats.completion - 2 / 22) < 1e-9);
+    assert.equal(stats.average, stats.completion);
+  });
+});
+
+describe("chart series", () => {
+  it("weekly buckets end with this week, Monday first, and sum the week", () => {
+    const data = base({ doChecks: { "2026-11-17": { read: { done: true, notes: "" } } } });
+    const weeks = weeklyBuckets(data, read, TODAY, 3);
+    assert.equal(weeks.length, 3);
+    assert.equal(weeks[2]?.start, "2026-11-23");
+    assert.equal(weeks[1]?.start, "2026-11-16");
+    assert.equal(weeks[1]?.hits, 1);
+    assert.equal(weeks[1]?.countable, 7);
+  });
+
+  it("month bars give one bar per day with the amount for amount habits", () => {
+    const habit = { id: "pages", label: "Read", since: "2026-11-01", amount: { unit: "pages" } };
+    const ref: HabitRef = { kind: "do", habit };
+    const data = base({ dos: [habit], doChecks: { "2026-11-05": { pages: { done: true, notes: "", value: 12 } } } });
+    const bars = monthBars(data, ref, "2026-11", TODAY);
+    assert.equal(bars.length, 30);
+    assert.equal(bars[4]?.value, 12);
+    assert.equal(bars[4]?.day, 5);
+  });
+
+  it("streak series runs day by day", () => {
+    const data = base({
+      doChecks: {
+        "2026-11-20": { read: { done: true, notes: "" } },
+        "2026-11-21": { read: { done: true, notes: "" } },
+      },
+    });
+    const series = streakSeries(dayStates(data, read, TODAY, "2026-11-19"));
+    assert.deepEqual(
+      series.map((point) => point.streak),
+      [0, 1, 2, 0, 0], // 19 missed (stays 0), 20, 21 done, 22 missed, 23 open
+    );
+  });
+
+  it("last days strip ends today", () => {
+    const days = lastDays(base(), read, TODAY);
+    assert.equal(days.length, 7);
+    assert.equal(days[6]?.date, TODAY);
+    assert.equal(days[6]?.state, "open");
+  });
+});
+
+describe("calendar helpers", () => {
+  it("month grid is Monday first and pads the weeks", () => {
+    const rows = monthGrid("2026-11");
+    assert.ok(rows.every((row) => row.length === 7));
+    // 1 Nov 2026 is a Sunday: Monday-first, that is the last column of the first row.
+    assert.deepEqual(rows[0], [null, null, null, null, null, null, "2026-11-01"]);
+    assert.equal(rows[rows.length - 1]?.[0], "2026-11-30"); // 30 Nov is a Monday, first column of the last row
+  });
+
+  it("shifts months across years", () => {
+    assert.equal(shiftMonth("2026-12", 1), "2027-01");
+    assert.equal(shiftMonth("2027-01", -1), "2026-12");
+  });
+});
diff -ruN a/lifeos-app-main/src/lib/lifeos/habit-view.ts b/lifeos-app-main/src/lib/lifeos/habit-view.ts
--- a/lifeos-app-main/src/lib/lifeos/habit-view.ts	1970-01-01 05:30:00.000000000 +0530
+++ b/lifeos-app-main/src/lib/lifeos/habit-view.ts	2026-11-25 18:11:31.530192045 +0530
@@ -0,0 +1,229 @@
+import { formatMonthDay, isScheduled, mondayOf, parseISODate, shiftDate, type Habit, type LifeData } from "./model";
+import { earliestDate } from "./score";
+
+/**
+ * Per-habit history for the Habits tab and each habit's dashboard (v2.2).
+ * Pure functions over LifeData: no state, no React.
+ *
+ * Streak rules match the Today screen and the Board: a done day extends the run, a missed day ends it,
+ * and days that do not count (not scheduled, frozen, before the start date, today not logged yet, the future)
+ * neither extend nor break it.
+ */
+
+export type HabitKind = "do" | "dont";
+export type HabitRef = { kind: HabitKind; habit: Habit };
+
+/**
+ * done    - the habit was kept (ticked, target reached, or "Avoided")
+ * missed  - it applied and was not kept (a past day with nothing done, or "Gave In")
+ * open    - it applies today and is not logged yet
+ * off     - not scheduled on this weekday
+ * frozen  - a streak freeze protects this day
+ * before  - before the habit's start date
+ * future  - after today
+ */
+export type DayState = "done" | "missed" | "open" | "off" | "frozen" | "before" | "future";
+
+export type DayRecord = {
+  date: string;
+  state: DayState;
+  /** Logged amount for an amount habit (0 when nothing is logged). */
+  value: number;
+  notes: string;
+  /** Don'ts only: "Avoided", "Gave In" or "" (not yet marked). */
+  status: "Avoided" | "Gave In" | "";
+};
+
+export type HabitStats = {
+  /** Kept days (done) for a tick or don't; total amount for an amount habit. */
+  total: number;
+  /** Days the habit applied and has passed (done + missed). */
+  countable: number;
+  /** Share of countable days kept, 0–1. */
+  completion: number;
+  /** Amount habits: average amount per countable day. Other habits: same as completion. */
+  average: number;
+  current: number;
+  best: number;
+};
+
+export type WeekBucket = {
+  start: string;
+  end: string;
+  /** Short label for charts, e.g. "16 Nov". */
+  label: string;
+  hits: number;
+  countable: number;
+  amount: number;
+  completion: number;
+};
+
+export type MonthBar = { date: string; day: number; state: DayState; value: number };
+
+export type StreakPoint = { date: string; streak: number };
+
+const COUNTABLE: ReadonlySet<DayState> = new Set(["done", "missed"]);
+
+export function findHabit(data: LifeData, id: string): HabitRef | null {
+  const dos = data.dos.find((habit) => habit.id === id);
+  if (dos) return { kind: "do", habit: dos };
+  const dont = data.donts.find((habit) => habit.id === id);
+  return dont ? { kind: "dont", habit: dont } : null;
+}
+
+/** First day the habit counts: its start date, or for habits made before v2.1 the first day anything was logged. */
+export function habitStart(data: LifeData, habit: Habit): string {
+  return habit.since ?? earliestDate(data);
+}
+
+export function dayRecord(data: LifeData, ref: HabitRef, date: string, today: string): DayRecord {
+  const { kind, habit } = ref;
+  const doDay = kind === "do" ? data.doChecks[date]?.[habit.id] : undefined;
+  const dontDay = kind === "dont" ? data.dontChecks[date]?.[habit.id] : undefined;
+  const value = doDay?.value ?? 0;
+  const notes = (kind === "do" ? doDay?.notes : dontDay?.notes) ?? "";
+  const status = dontDay?.status ?? "";
+
+  let state: DayState;
+  if (date > today) state = "future";
+  else if (habit.since && date < habit.since) state = "before";
+  else if (data.freezeDays[date] === true) state = "frozen";
+  else if (!isScheduled(habit, date)) state = "off";
+  else if (kind === "do" ? doDay?.done === true : status === "Avoided") state = "done";
+  else if (kind === "dont" && status === "Gave In") state = "missed";
+  else state = date === today ? "open" : "missed";
+
+  return { date, state, value, notes, status: kind === "dont" ? status : "" };
+}
+
+/** Records from the habit's start (or `from`, if later) up to today, oldest first. */
+export function dayStates(data: LifeData, ref: HabitRef, today: string, from?: string): DayRecord[] {
+  const start = from ?? habitStart(data, ref.habit);
+  const records: DayRecord[] = [];
+  if (start > today) return records;
+  for (let date = start, guard = 0; date <= today && guard < 4000; date = shiftDate(date, 1), guard += 1) {
+    records.push(dayRecord(data, ref, date, today));
+  }
+  return records;
+}
+
+/** Current and best streak. Done extends, missed breaks, every other state is neutral. */
+export function streakFrom(records: DayRecord[]): { current: number; best: number } {
+  let run = 0;
+  let best = 0;
+  for (const record of records) {
+    if (record.state === "done") run += 1;
+    else if (record.state === "missed") run = 0;
+    best = Math.max(best, run);
+  }
+  return { current: run, best };
+}
+
+/** Running streak after each day (for the streak history chart). */
+export function streakSeries(records: DayRecord[]): StreakPoint[] {
+  let run = 0;
+  return records.map((record) => {
+    if (record.state === "done") run += 1;
+    else if (record.state === "missed") run = 0;
+    return { date: record.date, streak: run };
+  });
+}
+
+export function habitStats(data: LifeData, ref: HabitRef, today: string): HabitStats {
+  const records = dayStates(data, ref, today);
+  const countableDays = records.filter((record) => COUNTABLE.has(record.state));
+  const kept = records.filter((record) => record.state === "done").length;
+  const isAmount = ref.kind === "do" && !!ref.habit.amount;
+  const totalAmount = isAmount ? records.reduce((sum, record) => sum + record.value, 0) : 0;
+  const completion = countableDays.length ? kept / countableDays.length : 0;
+  const { current, best } = streakFrom(records);
+  return {
+    total: isAmount ? totalAmount : kept,
+    countable: countableDays.length,
+    completion,
+    average: isAmount ? (countableDays.length ? totalAmount / countableDays.length : 0) : completion,
+    current,
+    best,
+  };
+}
+
+/** Last `count` weeks (Monday first), oldest first, ending with the week of `today`. */
+export function weeklyBuckets(data: LifeData, ref: HabitRef, today: string, weeks = 12): WeekBucket[] {
+  const thisMonday = mondayOf(today);
+  const buckets: WeekBucket[] = [];
+  for (let back = weeks - 1; back >= 0; back -= 1) {
+    const start = shiftDate(thisMonday, -7 * back);
+    const end = shiftDate(start, 6);
+    let hits = 0;
+    let countable = 0;
+    let amount = 0;
+    for (let date = start; date <= end; date = shiftDate(date, 1)) {
+      const record = dayRecord(data, ref, date, today);
+      if (record.state === "done") hits += 1;
+      if (COUNTABLE.has(record.state)) countable += 1;
+      amount += record.value;
+    }
+    buckets.push({
+      start,
+      end,
+      label: formatMonthDay(start),
+      hits,
+      countable,
+      amount,
+      completion: countable ? hits / countable : 0,
+    });
+  }
+  return buckets;
+}
+
+/** One bar per day of a month (YYYY-MM): the logged amount for amount habits, otherwise 1 for kept, 0 otherwise. */
+export function monthBars(data: LifeData, ref: HabitRef, month: string, today: string): MonthBar[] {
+  const days = daysInMonth(month);
+  const bars: MonthBar[] = [];
+  for (let day = 1; day <= days; day += 1) {
+    const date = `${month}-${String(day).padStart(2, "0")}`;
+    const record = dayRecord(data, ref, date, today);
+    const isAmount = ref.kind === "do" && !!ref.habit.amount;
+    bars.push({ date, day, state: record.state, value: isAmount ? record.value : record.state === "done" ? 1 : 0 });
+  }
+  return bars;
+}
+
+/** Monday-first weeks of a month (YYYY-MM); null pads the first and last week. */
+export function monthGrid(month: string): (string | null)[][] {
+  const days = daysInMonth(month);
+  const first = parseISODate(`${month}-01`);
+  const lead = (first.getDay() + 6) % 7;
+  const cells: (string | null)[] = [...Array<null>(lead).fill(null)];
+  for (let day = 1; day <= days; day += 1) cells.push(`${month}-${String(day).padStart(2, "0")}`);
+  while (cells.length % 7 !== 0) cells.push(null);
+  const rows: (string | null)[][] = [];
+  for (let i = 0; i < cells.length; i += 7) rows.push(cells.slice(i, i + 7));
+  return rows;
+}
+
+/** The last seven days ending today (oldest first), for the list strip. */
+export function lastDays(data: LifeData, ref: HabitRef, today: string, count = 7): DayRecord[] {
+  const days: DayRecord[] = [];
+  for (let back = count - 1; back >= 0; back -= 1) {
+    days.push(dayRecord(data, ref, shiftDate(today, -back), today));
+  }
+  return days;
+}
+
+/** Month key (YYYY-MM) shifted by whole months. */
+export function shiftMonth(month: string, delta: number): string {
+  const [y, m] = month.split("-").map(Number);
+  const date = new Date(y as number, (m as number) - 1 + delta, 1);
+  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
+}
+
+export function monthOf(iso: string): string {
+  return iso.slice(0, 7);
+}
+
+function daysInMonth(month: string): number {
+  const [y, m] = month.split("-").map(Number);
+  return new Date(y as number, m as number, 0).getDate();
+}
+
